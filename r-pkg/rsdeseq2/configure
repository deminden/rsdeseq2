#!/usr/bin/env sh
set -eu

package_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v cargo >/dev/null 2>&1; then
  echo "rsdeseq2 requires Cargo to build its Rust backend" >&2
  exit 1
fi
# The Rust core is not committed under src/rust/vendor. In a git checkout
# configure copies it from crates/ on every build, so it is never stale; the
# R source package (scripts/release/build_r_source.sh) ships the copy
# together with the vendored third-party crates.
repo_root=$(CDPATH= cd -- "$package_root/../.." && pwd)
if [ -f "$repo_root/scripts/release/sync_r_vendor.py" ] && [ -f "$repo_root/crates/rsdeseq2/Cargo.toml" ]; then
  if ! command -v python3 >/dev/null 2>&1; then
    echo "rsdeseq2 configure: python3 is needed to copy the Rust core from crates/" >&2
    exit 1
  fi
  python3 "$repo_root/scripts/release/sync_r_vendor.py"
elif [ ! -f "$package_root/src/rust/vendor/rsdeseq2/Cargo.toml" ]; then
  echo "rsdeseq2 configure: src/rust/vendor is missing; build the source package with scripts/release/build_r_source.sh" >&2
  exit 1
fi
if [ -f "$package_root/src/rust/cargo/config.toml" ]; then
  cargo_offline="--offline --config cargo/config.toml"
else
  cargo_offline=""
fi
if [ -f "$package_root/src/rust/vendor-crates.tar.xz" ]; then
  if [ -z "$cargo_offline" ]; then
    echo "rsdeseq2 configure: offline Cargo config is missing from the source archive" >&2
    exit 1
  fi
  (cd "$package_root/src/rust" && tar -xf vendor-crates.tar.xz)
fi
if [ "${1:-}" = "--windows" ]; then
  rust_target=x86_64-pc-windows-gnullvm
  if ! command -v x86_64-w64-mingw32-clang >/dev/null 2>&1; then
    echo "rsdeseq2 configure: add the UCRT LLVM-MinGW bin directory to PATH" >&2
    exit 1
  fi
  if ! printf '#include <_mingw.h>\n#ifndef _UCRT\n#error UCRT required\n#endif\n' |
    x86_64-w64-mingw32-clang -x c -fsyntax-only -; then
    echo "rsdeseq2 configure: use the UCRT build of LLVM-MinGW" >&2
    exit 1
  fi
  if ! rust_libdir=$(rustc --print target-libdir --target "$rust_target") || [ ! -d "$rust_libdir" ]; then
    echo "rsdeseq2 configure: install the Rust standard library for $rust_target" >&2
    exit 1
  fi
  sed -e "s|@CARGO_OFFLINE@|$cargo_offline|g" -e "s|@RUST_TARGET@|$rust_target|g" \
    "$package_root/src/Makevars.win.in" > "$package_root/src/Makevars.win"
  echo "rsdeseq2 configure: enabled the Rust core static library."
  exit 0
fi
case "$(uname -s)" in
  Linux)
    rust_link_libraries="-lpthread -lm -ldl"
    rust_linker_flags="-Wl,-x"
    ;;
  Darwin)
    rust_link_libraries="-lpthread -lm"
    # R reaches the C entry points through R_init_rsdeseq2's registered table.
    # Keep the initialization symbol public so unused Rust code can be stripped.
    rust_linker_flags="-Wl,-x,-dead_strip,-exported_symbol,_R_init_rsdeseq2"
    ;;
  *)
    rust_link_libraries="-lpthread -lm"
    rust_linker_flags=""
    ;;
esac
sed "s|@RUST_LINK_LIBS@|$rust_link_libraries|g" \
  "$package_root/src/Makevars.in" |
  sed "s|@RUST_LINK_FLAGS@|$rust_linker_flags|g" |
  sed "s|@CARGO_OFFLINE@|$cargo_offline|g" \
  > "$package_root/src/Makevars"
echo "rsdeseq2 configure: enabled the Rust core static library."
