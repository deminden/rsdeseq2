RUST_BACKEND = rust/target/release/librsdeseq2_r.a
all: $(SHLIB)

$(RUST_BACKEND): FORCE
	cd rust && cargo build --release --locked

FORCE:
.PHONY: FORCE

entrypoint.o: $(RUST_BACKEND) validation.h fit_abi.h
replacement_counts.o: $(RUST_BACKEND) validation.h fit_abi.h
row_preparation.o: $(RUST_BACKEND) validation.h
model_matrix.o: $(RUST_BACKEND) validation.h
formula_request.o: $(RUST_BACKEND) validation.h formula_transport.h
formula_encode.o formula_decode.o: formula_transport.h
contrast_batch.o: $(RUST_BACKEND) validation.h contrast_inference.h contrast_zero.h
contrast_inference.o: $(RUST_BACKEND) validation.h contrast_inference.h contrast_zero.h
contrast_zero.o: $(RUST_BACKEND) validation.h contrast_zero.h
inference_statistics.o: $(RUST_BACKEND) validation.h inference_statistics.h
result_policy.o: $(RUST_BACKEND) validation.h result_policy.h
result_filtering.o: $(RUST_BACKEND) validation.h result_filtering.h

PKG_LIBS = $(RUST_BACKEND) @RUST_LINK_LIBS@ @RUST_LINK_FLAGS@
