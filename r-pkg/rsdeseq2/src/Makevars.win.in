# Windows currently requires a Rust GNU toolchain compatible with the Rtools
# linker. Build the Rust static library before linking the R .Call adapter.
RUST_BACKEND = rust/target/release/librsdeseq2_r.a

all: $(SHLIB)

$(RUST_BACKEND): FORCE
	cd rust && cargo build --release --locked

FORCE:
.PHONY: FORCE

entrypoint.o: $(RUST_BACKEND)

PKG_LIBS = $(RUST_BACKEND)
