# Windows currently requires a Rust GNU toolchain compatible with the Rtools
# linker. Build the Rust static library before linking the R .Call adapter.
RUST_BACKEND = rust/target/release/librsdeseq2_r.a

all: $(SHLIB)

$(RUST_BACKEND): FORCE
	cd rust && cargo build --release --locked

FORCE:
.PHONY: FORCE

entrypoint.o: $(RUST_BACKEND) validation.h
contrast_inference.o: $(RUST_BACKEND) validation.h contrast_inference.h contrast_zero.h
contrast_zero.o: $(RUST_BACKEND) validation.h contrast_zero.h
inference_statistics.o: $(RUST_BACKEND) validation.h inference_statistics.h
result_filtering.o: $(RUST_BACKEND) validation.h result_filtering.h

PKG_LIBS = $(RUST_BACKEND)
